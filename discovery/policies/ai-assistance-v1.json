{
  "policy_id": "HWG-DISC-AI-POLICY-001",
  "version": "1.2.0",
  "default_mode": "explicit",
  "deterministic_first": true,
  "max_ai_requests_per_run": 3,
  "required_context": [
    "run_id",
    "provider_id",
    "unresolved_questions",
    "deterministic_evidence"
  ],
  "output_status": "CANDIDATE",
  "output_evidence_level": "E0",
  "direct_profile_mutation": false,
  "direct_certification": false,
  "record_provider_model": true,
  "record_purpose": true,
  "target_provider_self_use": {
    "user_approval_required": true,
    "deterministic_send_path_required": true,
    "deterministic_receive_path_required": true,
    "deterministic_completion_detection_required": true,
    "controlled_roundtrip_required": true,
    "transport_fingerprint_must_match": true,
    "qualification_schema": "urn:hwg:schema:provider-self-use-qualification:1.0.0",
    "fail_closed": true
  },
  "automatic_readonly_diagnosis": true,
  "automatic_readonly_diagnosis_scope": [
    "ACCESS_DIAGNOSTIC_REQUIRED",
    "QUALIFICATION_FAILED_AFTER_COMMIT",
    "QUALIFICATION_DIAGNOSIS_COMPLETE",
    "EXPLORER_DEEPENING"
  ]
}
